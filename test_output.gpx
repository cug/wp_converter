 </wpt>
 <wpt lat="45.139131" lon="-74.496757">
  <ele>48.42066010180861</ele>
  <time>2024-06-22 00:00:00 UTC</time>
  <name>Flying J Travel Plaza about 20 minutes east of Cornwall Ontario </name>
  <desc>Potable drinking water at 5 of the gas pumps. We asked the staff inside if it was ok to fill up and they said yes. &#xA;&#xA;Date verified: 2024-06-22 00:00:00 UTC&#xA;Open: Yes&#xA;&#xA;https://ioverlander.com/places/195427 (network required)&#xA;</desc>
  <type>Water</type>
  <extensions>
   <osmand:icon>amenity_drinking_water</osmand:icon>
   <osmand:background>circle</osmand:background>
   <osmand:color>#0099ff</osmand:color>
