  </extensions>
 </wpt>
 <wpt lat="50.533291" lon="-103.667607">
  <ele>590.6228731749579</ele>
  <time>2023-08-12 00:00:00 UTC</time>
  <name>Car Wash (Water &amp; Laundromat)</name>
  <desc>A very nice and clean place. Washing machines are all new. Machine to change your bill. Station to fill bottle 18,9 litres / $2,50. Soap available. &#xA;&#xA;Date verified: 2023-08-12 00:00:00 UTC&#xA;Open: Yes&#xA;&#xA;https://ioverlander.com/places/165524 (network required)&#xA;</desc>
