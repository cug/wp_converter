 <wpt lat="53.606763" lon="-113.483074">
  <ele>655.7028841736743</ele>
  <time>2023-07-02 00:00:00 UTC</time>
  <name>LC Coin Laundry</name>
  <desc>Small (3$), Medium (5$) and Large (6$) machines available, dryer is 25ct. per 5 minutes;&#xA;Sadly no places to sit comfortably or to charge devices but helpful staff who also changed our bills in coins (ATM also available)&#xA;&#xA;Date verified: 2023-07-02 00:00:00 UTC&#xA;Open: Yes&#xA;&#xA;https://ioverlander.com/places/227695 (network required)&#xA;</desc>
