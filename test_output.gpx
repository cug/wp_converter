 </wpt>
 <wpt lat="50.689773" lon="-119.342079">
  <ele>357.7516091861148</ele>
  <time>2023-09-11 00:00:00 UTC</time>
  <name>Grass Root Dairies</name>
  <desc>Canada’s first 100% grass fed, grain free dairy farm.&#xA;Lovely farm store selling amazing cheese, yoghurt, fresh milk, quark, ice cream etc.&#xA;The old gouda is to die for.&#xA;You can sample before purchasing.&#xA;It’s a great stop if you travel with small children (farm animals, large sandbox and playground, picnic benches.&#xA;&#xA;Date verified: 2023-09-11 00:00:00 UTC&#xA;Open: Yes&#xA;&#xA;https://ioverlander.com/places/241227 (network required)&#xA;</desc>
  <type>Shopping</type>
  <extensions>
   <osmand:icon>shop_supermarket</osmand:icon>
   <osmand:background>circle</osmand:background>
   <osmand:color>#339933</osmand:color>
