   <osmand:amenity_type>user_defined_other</osmand:amenity_type>
  </extensions>
 </wpt>
 <wpt lat="46.716209" lon="-71.265620">
  <ele>37.34014892578125</ele>
  <time>2024-07-02 00:00:00 UTC</time>
  <name>Chez Karine et Louis</name>
  <desc>Family home with free parking in front of the house (max 40 feets) and some services availables (laundry, shower, water, electricity) for a small contribution. Bring on your smile and good stories!&#xA;Please contact at least 4 hours before arriving to check the availability : karine.banville.tupperware@gmail.com or 418-456-1164 (french, english and a bit spanish)&#xA;&#xA;Date verified: 2024-07-02 00:00:00 UTC&#xA;Open: Yes&#xA;Electricity: Yes - At Sites&#xA;Wifi: Yes - Average&#xA;Kitchen: No&#xA;Restaurant: No&#xA;Showers: No&#xA;Water: Yes&#xA;Toilets: No&#xA;Big rig friendly: Yes&#xA;Tent friendly: No&#xA;Pet friendly: No&#xA;&#xA;https://ioverlander.com/places/271420 (network required)&#xA;</desc>
