   <osmand:background>circle</osmand:background>
   <osmand:color>#00ff00</osmand:color>
   <osmand:amenity_subtype>user_defined_other_postcode</osmand:amenity_subtype>
   <osmand:amenity_type>user_defined_other</osmand:amenity_type>
  </extensions>
 </wpt>
 <wpt lat="48.386071" lon="-78.127567">
  <ele>0.0</ele>
  <time>2022-08-21 00:00:00 UTC</time>
  <name>Petite halte routière </name>
  <desc>Small roadside rest stop with toilets and tables. Little traffic at night.&#xA;&#xA;Français&#xA;Petite halte routière en bord de route avec toilettes et tables. Peu de trafic la nuit. &#xA;&#xA;Date verified: 2022-08-21 00:00:00 UTC&#xA;Open: Yes&#xA;Electricity: No&#xA;Wifi: No&#xA;Kitchen: No&#xA;Restaurant: No&#xA;Showers: No&#xA;Water: No&#xA;Toilets: Pit Toilets&#xA;Big rig friendly: Unknown&#xA;Tent friendly: Yes&#xA;Pet friendly: Yes&#xA;&#xA;https://ioverlander.com/places/190147 (network required)&#xA;</desc>
