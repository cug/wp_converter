   <osmand:amenity_type>user_defined_other</osmand:amenity_type>
  </extensions>
 </wpt>
 <wpt lat="49.274522" lon="-91.345925">
  <ele>462.5097450269386</ele>
  <time>2024-07-22 22:52:46 UTC</time>
  <name>Real nice spot in the forest</name>
  <desc>This is a real nice spot in the forest 4km away from TCH. If you want, you can go swim in the „lake without name“ 20 meter away. You can hear the highway a little bit in the distance. There is enough place for 3 or 4 small rigs or vans. Starlink works fine! The forestroad is mostly good only a few parts a little bit rough. You don’t need 4x4 maybe a little bit high clearance. We stayed two nights and were the hole time allone. At the morning one truck pass the place.&#xA;&#xA;Date verified: 2024-07-22 22:52:46 UTC&#xA;Open: Yes&#xA;Electricity: No&#xA;Wifi: No&#xA;Kitchen: No&#xA;Restaurant: No&#xA;Showers: No&#xA;Water: No&#xA;Toilets: No&#xA;Big rig friendly: No&#xA;Tent friendly: Yes&#xA;Pet friendly: Yes&#xA;&#xA;https://ioverlander.com/places/239051 (network required)&#xA;</desc>
  <type>Wild Camping</type>
  <extensions>
   <osmand:icon>tourism_camp_site</osmand:icon>
   <osmand:background>circle</osmand:background>
   <osmand:color>#00ff00</osmand:color>
