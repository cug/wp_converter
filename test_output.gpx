 <wpt lat="49.156056" lon="-123.170292">
  <ele>-6.86480712890625</ele>
  <time>2023-06-29 00:00:00 UTC</time>
  <name>Blundell Coin Laundromat </name>
  <desc>Laundromat with lots of shady street parking for big rigs. Quarters only, washes range from $2.75 - $5 per load and $25/4 mina dryer. Free WiFi, very clean. Many machines available at 1pm on Sunday.&#xA;&#xA;Date verified: 2023-06-29 00:00:00 UTC&#xA;Open: Yes&#xA;&#xA;https://ioverlander.com/places/154649 (network required)&#xA;</desc>
  <type>Laundromat</type>
