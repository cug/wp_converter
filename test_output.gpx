   <osmand:amenity_type>user_defined_other</osmand:amenity_type>
  </extensions>
 </wpt>
 <wpt lat="49.066877" lon="-123.975475">
  <ele>126.79530537035316</ele>
  <time>2022-08-31 00:00:00 UTC</time>
  <name>4WD easier option wild camping</name>
  <desc>We were aiming to get to the 4WD spot by the river but decided to stop here because the trail was too much for us to risk our truck or camper. &#xA;&#xA;This is a spot at the side of the trail. Super quiet. Seen a couple of trucks pass by with friendly locals. 1 bar Telcel network. Lots of large mosquitoes though!! &#xA;&#xA;Date verified: 2022-08-31 00:00:00 UTC&#xA;Open: Yes&#xA;Electricity: No&#xA;Wifi: No&#xA;Kitchen: No&#xA;Restaurant: No&#xA;Showers: No&#xA;Water: No&#xA;Toilets: No&#xA;Big rig friendly: No&#xA;Tent friendly: Yes&#xA;Pet friendly: Yes&#xA;&#xA;https://ioverlander.com/places/190174 (network required)&#xA;</desc>
